#!/usr/bin/env bash

source_env "${HOME}"

# Loads the Nix flake development shell if Nix is available.
has nix && use flake

# Install pre-commit hooks only when git does not use a custom hooksPath.
# Beads sets core.hooksPath, which makes pre-commit refuse to install.
# When core.hooksPath is set, pre-commit runs from the beads hook instead.
if has pre-commit && [ -z "$(git config --local --get core.hooksPath 2>/dev/null)" ]; then
  pre-commit install
fi

# Generate a wrapper script so BROWSER works with paths that contain spaces.
# Tools such as gh split BROWSER on whitespace, which breaks paths like
# "/Applications/Brave Browser.app/...". The wrapper avoids this problem.
mkdir --parents .direnv/bin
cat > .direnv/bin/browser << 'EOF'
#!/usr/bin/env bash
# exec "/Applications/Arc.app/Contents/MacOS/Arc" "$@"
exec "/Applications/Brave Browser.app/Contents/MacOS/Brave Browser" "$@"
# exec "/Applications/Brave Browser Beta.app/Contents/MacOS/Brave Browser Beta" "$@"
# exec "/Applications/Firefox.app/Contents/MacOS/firefox" "$@"
# exec "/Applications/Firefox Developer Edition.app/Contents/MacOS/firefox" "$@"
# exec "/Applications/Firefox Nightly.app/Contents/MacOS/firefox" "$@"
# exec "/Applications/Google Chrome.app/Contents/MacOS/Google Chrome" "$@"
# exec "/Applications/Google Chrome Beta.app/Contents/MacOS/Google Chrome Beta" "$@"
# exec "/Applications/Google Chrome Canary.app/Contents/MacOS/Google Chrome Canary" "$@"
# exec "/Applications/Google Chrome Dev.app/Contents/MacOS/Google Chrome Dev" "$@"
# exec "/Applications/Opera.app/Contents/MacOS/Opera" "$@"
# exec "/Applications/Safari.app/Contents/MacOS/Safari" "$@"
# exec "/Applications/Vivaldi.app/Contents/MacOS/Vivaldi" "$@"
EOF
chmod +x .direnv/bin/browser
PATH_add .direnv/bin
export BROWSER=browser

